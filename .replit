modules = ["web", "nodejs-20", "bash", "python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "release-smoke"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "release-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:release"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start"]
build = ["npm", "run", "build:publish"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
